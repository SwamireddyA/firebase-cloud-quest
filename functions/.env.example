# Copy to functions/.env (NOT committed). Server-side only; never put this in the Flutter app.
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-free-key-here
GEMINI_MODEL=gemini-2.5-flash
# Set to true to run the coach with a built-in deterministic mock (no key, no network).
COACH_MOCK=false
# Set to true to make the read-only tool fail, to test the error path.
COACH_SIMULATE_TOOL_FAILURE=false
